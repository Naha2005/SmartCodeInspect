# Smart Code Inspection Platform - Environment Configuration Template
FLASK_ENV=development
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# AI Advisory Configuration (Optional)
# Providers: 'gemini' or 'groq'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_RPM=10
GEMINI_COOLDOWN_SECONDS=2.0
