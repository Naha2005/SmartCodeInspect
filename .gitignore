# ==========================================
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json

# ==========================================
# 2. Python Virtual Environments
# ==========================================
venv/
.venv/
env/
ENV/
backend/venv/

