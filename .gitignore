# ==========================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/

# ==========================================
# 4. Python Cache & Test Artifacts
# ==========================================
__pycache__/
backend/__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 5. Temporary Sandbox & Isolation Files
# ==========================================
backend/temp/
temp/
sci_java_*

# ==========================================
